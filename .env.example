# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kpi_demo"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=

# Microsoft Graph API (Azure AD App Registration)
# Register a multi-tenant app at https://portal.azure.com > App registrations
# Set "Supported account types" to "Accounts in any organizational directory"
# Add redirect URI: http://localhost:4721/api/auth/outlook/callback
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
# Leave empty or set to "common" for multi-tenant; set a specific tenant ID to restrict to one org
AZURE_AD_TENANT_ID=""

# HubSpot API
HUBSPOT_ACCESS_TOKEN=""

# App Config
INTERNAL_DOMAIN="company.example"
APP_URL="http://localhost:3000"

# Microsoft Teams Webhook (for classification reminders)
TEAMS_WEBHOOK_URL=""

# Demo Mode (set to "true" to use seed data instead of live APIs)
DEMO_MODE="true"

# Multi-Tenant
TENANT_ENCRYPTION_KEY="generate-a-64-char-hex-string-for-production"
TENANT_SLUGS="default"
TENANT_SLUG="default"

# OAuth redirect base URL (must match Azure AD redirect URI)
OAUTH_REDIRECT_BASE="https://YOUR_VPS_IP"

# Cron job secret (used to authenticate scheduled job endpoints)
CRON_SECRET=

# Anthropic API key (for AI-powered classification)
ANTHROPIC_API_KEY=""

# Explicit local demo/test passwords; never reuse a real account password.
SEED_PASSWORD=
E2E_TEST_PASSWORD=
